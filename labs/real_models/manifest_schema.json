{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI Math Guide GPU experiment manifest",
  "type": "object",
  "required": [
    "schema_version", "experiment_id", "lesson_id", "status", "source",
    "command", "timestamps", "versions", "gpu", "model", "seed",
    "determinism", "dtype", "mode", "inputs", "hook", "resources",
    "artifacts", "assertions", "failure"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "status": {"enum": ["passed", "failed"]},
    "experiment_id": {"type": "string"},
    "lesson_id": {"type": "string"},
    "source": {"type": "object"},
    "command": {"type": "string"},
    "timestamps": {"type": "object"},
    "versions": {"type": "object"},
    "gpu": {"type": "object"},
    "model": {"type": "object"},
    "seed": {"type": "integer"},
    "determinism": {"type": "object"},
    "dtype": {"type": "string"},
    "mode": {"type": "string"},
    "inputs": {"type": "object"},
    "hook": {"type": "object"},
    "resources": {"type": "object"},
    "artifacts": {"type": "array"},
    "assertions": {"type": "object"},
    "failure": {"type": ["string", "null"]}
  },
  "additionalProperties": true
}
